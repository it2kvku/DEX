# === RPC Providers (client — bản build Next) ===
# Lấy API key tại https://dashboard.alchemy.com
# Chỉ dùng cho bản `next dev`/`next build` (key inline vào bundle client).
# Bản deploy Cloudflare (vinext) KHÔNG dùng biến này cho client — xem ALCHEMY_API_KEY bên dưới.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# === RPC Provider (server — bản deploy Cloudflare Worker) ===
# Secret server-side cho RPC proxy /rpc/{chainId}. KHÔNG dùng tiền tố
# NEXT_PUBLIC_ — biến public bị inline vào bundle client, mất hết ý nghĩa giấu key.
# Set bằng cf CLI (không viết vào file .env):
#   cf workers secrets update ALCHEMY_API_KEY
# Hoặc qua dashboard Cloudflare. Không có secret thì proxy fallback sang RPC
# công khai — app vẫn chạy.
ALCHEMY_API_KEY=

# === WalletConnect ===
# Lấy Project ID tại https://cloud.reown.com (trước đây là WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Block Explorer API (dùng cho History module sau này) ===
# Etherscan V2 API key dùng chung cho nhiều chain: https://etherscan.io/apis
NEXT_PUBLIC_ETHERSCAN_API_KEY=
